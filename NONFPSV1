-- ==================== ตั้งค่าระบบ KEY PROVIDER & JNKIE ====================
local HttpService = game:GetService("HttpService")
local KeyLink = "https://jnkie.com/dashboard?oauth_linked=discord&validation_error=NOT_IN_GUILD"

local KeyProvider = {
    Enabled = true,
    RawKeyURL = "https://raw.githubusercontent.com/YOUR_USERNAME/YOUR_REPO/main/keys.json", -- ใส่ลิงก์ RAW เก็บ Key
    LocalKeys = {
        "ADMIN_KEY_1234",
        "FREE_ACCESS"
    }
}

-- ฟังก์ชันดึงและตรวจสอบคีย์จาก Key Provider
local function FetchProviderKeys()
    local validKeys = {}
    
    for _, k in ipairs(KeyProvider.LocalKeys) do
        table.insert(validKeys, k)
    end
    
    if KeyProvider.Enabled and KeyProvider.RawKeyURL ~= "" and not KeyProvider.RawKeyURL:find("YOUR_USERNAME") then
        local success, result = pcall(function()
            return game:HttpGet(KeyProvider.RawKeyURL)
        end)
        
        if success and result then
            local jsonSuccess, decoded = pcall(function()
                return HttpService:JSONDecode(result)
            end)
            
            if jsonSuccess and type(decoded) == "table" then
                for _, k in ipairs(decoded) do
                    table.insert(validKeys, tostring(k))
                end
            else
                for line in result:gmatch("[^\r\n]+") do
                    local trimmedKey = line:match("^%s*(.-)%s*$")
                    if trimmedKey and trimmedKey ~= "" then
                        table.insert(validKeys, trimmedKey)
                    end
                end
            end
        end
    end
    
    return validKeys
end

local AllowedKeys = FetchProviderKeys()

